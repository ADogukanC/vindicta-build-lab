# There is no database. The item/hero/progression catalogue that the admin
# panel edits lives in data/local-db.json on whatever machine runs the app;
# builds live in each visitor's own browser and are shared as copy-pasteable
# codes, never touching a server at all.

# --- Admin panel ----------------------------------------------------------
# Password for /admin. Required in production; defaults to "admin" in dev.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Any long random string.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
